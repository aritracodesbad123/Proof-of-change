{
  "name": "Proof-of-Change",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [
    8787
  ],
  "portsAttributes": {
    "8787": {
      "label": "Proof-of-Change console",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-console.sh || echo 'Console start failed; see /tmp/poc-console.log'",
  "secrets": {
    "TAVILY_API_KEY": {
      "description": "Your own Tavily API key. A check cannot run without the setup lookup. This project does not ship or share a key. Tavily keys are free. Set TAVILY_API_KEY before a check. The value is not stored in the repository.",
      "documentationUrl": "https://app.tavily.com/"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
