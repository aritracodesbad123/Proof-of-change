# Proof-of-Change server settings for one Nebius VM.
# setup.sh copies this to /etc/proof-of-change/env (owner root, mode 600) only if that file does not exist yet.
# Fill the values on the VM with: sudo nano /etc/proof-of-change/env
# Never commit real values. Every name below is read by the code on main.

# --- Hosted mode (required) ---
# Pull-request code runs only in Contree; if Contree cannot start, the check is "could not verify".
POC_HOSTED=1
POC_REQUIRE_CONTREE=1
# Checks per day (IST) for the whole console. The code defaults to 5.
POC_DAILY_CAP=5
# Tavily credit cap. The hosted console refuses every check while this is empty.
POC_TAVILY_CREDIT_CAP=

# --- Model and sandbox keys (required) ---
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TAVILY_API_KEY=

# --- GitHub ---
# Read-only token so GitHub API reads are not limited to 60 per hour. Optional but recommended.
GITHUB_TOKEN=
# GitHub App (only for the webhook service). The private key goes on one line with \n for each line break.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Repositories the App may check and comment on, comma-separated owner/repo. Empty means it refuses all.
POC_DEMO_REPOS=

# --- Console sign-in ---
# The address people open, for example https://203-0-113-7.sslip.io (setup.sh fills this in if empty).
POC_PUBLIC_URL=
POC_COOKIE_SECURE=1
# A long random value (setup.sh generates one if empty).
SECRET_KEY=
POC_ADMIN_EMAIL=
POC_SIGNUP_DISABLED=
POC_INVITE_CODE=
# Optional sign-in providers.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Used only by setup.sh, never by the app ---
# Space- or comma-separated addresses allowed to reach SSH (port 22), e.g. "198.51.100.4/32 203.0.113.0/24".
# Empty: setup.sh warns and leaves 22 open to everyone, key sign-in only.
POC_SSH_ALLOW_CIDRS=
