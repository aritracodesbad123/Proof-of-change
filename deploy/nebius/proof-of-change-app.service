[Unit]
Description=Proof-of-Change GitHub App webhook listener (local only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proof-of-change
Group=proof-of-change
WorkingDirectory=/opt/proof-of-change/app
EnvironmentFile=/etc/proof-of-change/env
Environment=HOME=/var/lib/proof-of-change
Environment=POC_OPS_DIR=/var/lib/proof-of-change
Environment=POC_OPS_RUNS=/var/lib/proof-of-change/runs
Environment=POC_REPORT_DIR=/var/lib/proof-of-change/reports
Environment=PYTHONUNBUFFERED=1
# Caddy forwards only POST /webhook here. Every App check uses --sandbox-backend contree --require-contree.
ExecStart=/opt/proof-of-change/venv/bin/python -m poc.github_app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/proof-of-change /opt/proof-of-change/app

[Install]
WantedBy=multi-user.target
