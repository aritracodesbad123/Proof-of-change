  "model_claims": [
   {
    "id": "C1",
    "text": "In Python 3.14, currying a partial with a placeholder incorrectly reverses argument order.",
    "source_quote": "On Python 3.14, `curry` concatenates a partial object's stored arguments as if they were a bound prefix. For `f(a, b, c)` returning its arguments and `base = partial(f, Placeholder, 2)`, `curry(base, 1)(3)` consequently returns `(3, 2, 1)` instead of `(1, 2, 3)`.",
    "testable": true,
    "expect": "differs"
   },
   {
    "id": "C2",
    "text": "Staged curry calls may raise before all arguments are supplied and the reported signature omits the placeholder parameter.",
    "source_quote": "Staged calls can raise before all arguments are supplied, and the reported signature drops the placeholder parameter.",
    "testable": true,
    "expect": "same"
   },
   {
    "id": "C3",
    "text": "Placeholder detection relies on identity comparison rather than ordinary argument equality.",
    "source_quote": "Placeholder detection uses identity so ordinary argument equality is not invoked.",
    "testable": true,
    "expect": "differs"
   },
   {
    "id": "C4",
    "text": "Before the fix, eight new test cases resulted in six regression failures and two passing controls.",
