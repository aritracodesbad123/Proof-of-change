    "testable": true,
    "expect": "same"
   },
   {
    "id": "C3",
    "text": "self.socket.close() set _closed = True without calling _real_close(), leaving the underlying OS socket file descriptor open (sock.fileno() != -1).",
    "source_quote": "`self.socket.close()` set `_closed = True` without calling `_real_close()`, leaving the underlying OS socket file descriptor open (`sock.fileno() != -1`).",
    "testable": false,
    "expect": "base",
    "base_description": true
   },
   {
    "id": "C4",
    "text": "Normalize and validate buffering (including rejecting unbuffered text streams) before creating socket.SocketIO and incrementing self.socket._io_refs.",
