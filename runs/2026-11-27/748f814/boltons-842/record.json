  "errors": [],
  "model_claims": [
   {
    "id": "C1",
    "text": "Before the fix, asciify deletes diaeresis letters that lack an entry in DEACCENT_MAP instead of converting them to their base letter.",
    "source_quote": "`strutils.asciify` deleted letters with a diaeresis that have no entry in `DEACCENT_MAP` (e.g. `\u00cb`, `\u00eb`, `\u00cf`, `\u00ef`) instead of deaccenting them to their base letter:",
    "testable": false,
    "expect": "base",
    "base_description": true
   },
   {
    "id": "C2",
    "text": "Before the fix, asciify('\u00cba \u00c9b \u00ebc') returns b'a Eb c', silently dropping \u00cb and \u00eb.",
    "source_quote": "b\"a Eb c\"",
    "testable": false,
    "expect": "base",
    "base_description": true
   },
   {
    "id": "C3",
    "text": "Before the fix, asciify('\u00cf') returns an empty byte string, dropping the character entirely.",
    "source_quote": "b\"\"",
    "testable": false,
    "expect": "base",
    "base_description": true
   },
   {
    "id": "C4",
    "text": "After the fix, asciify('\u00cba \u00c9b \u00ebc') returns b'Ea Eb ec', converting \u00cb and \u00eb to E and e.",
    "source_quote": "b\"Ea Eb ec\"",
    "testable": true,
    "expect": "differs"
   },
   {
    "id": "C5",
    "text": "After the fix, asciify('\u00cf') returns b'I', converting \u00cf to I.",
    "source_quote": "b\"I\"",
    "testable": true,
    "expect": "differs"
   },
   {
    "id": "C6",
    "text": "Letters that have explicit entries in DEACCENT_MAP (such as \u00c4\u2192Ae, \u00d6\u2192Oe, \u00dc\u2192Ue and their lowercase forms) retain their special mappings unchanged.",
    "source_quote": "Letters with their own map entry (`\u00c4` \u2192 `Ae`, `\u00d6` \u2192 `Oe`, `\u00dc` \u2192 `Ue`, and lowercase) never reach `__missing__`, so their special mapping is unchanged.",
    "testable": true,
    "expect": "same"
   },
   {
    "id": "C7",
    "text": "After the fix, no Latin-1 letter is dropped or replaced by a question mark.",
    "source_quote": "Also verified no Latin-1 letter is dropped or replaced by ? anymore.",
    "testable": true,
    "expect": "differs",
    "quote_match": "loose"
   }
  ],
