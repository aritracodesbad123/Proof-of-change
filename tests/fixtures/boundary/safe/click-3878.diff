+# Translation table for EchoingStdin to print the bytes that end `<stdin>` in a
+# terminal. Both are recognized on all platforms.
+_CONTROL_ECHO = {
+    # Ctrl+D on Unix.
+    b"\x04": b"^D\n",
+    # Ctrl+Z on Windows.
+    b"\x1a": b"^Z\n",
+}
+
 
