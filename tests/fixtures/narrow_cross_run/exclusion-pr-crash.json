{
  "files": ["pkg/mod.py", "pkg/tests/test_mod.py"],
  "package_py": ["pkg/mod.py"],
  "tests": {
    "main": {
      "pkg/tests/test_mod.py::test_new_case": "failed",
      "pkg/tests/test_mod.py::test_keep": "passed"
    },
    "pr": {
      "pkg/tests/test_mod.py::test_new_case": "passed",
      "pkg/tests/test_mod.py::test_keep": "passed"
    }
  },
  "probes": [
    {
      "id": "model-p1",
      "claims": [
        {
          "id": "C1",
          "text": "the returned value changes",
          "covers": ["out"],
          "expect": "differs"
        }
      ],
      "main": {"out": 1},
      "pr": {"out": 1, "probe.error": {"crash": "non-json output"}}
    }
  ]
}
